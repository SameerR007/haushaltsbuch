# Copy this file to .env.local, fill in what you need, then restart `npm run dev`:
#
#   cp .env.example .env.local
#
# Everything here is optional. .env.local is gitignored, so your keys stay on your computer.

# ---------------------------------------------------------------------------
# Langfuse tracing (optional). Off while the two keys below are empty.
# Get the keys in Langfuse: your project → Settings → API Keys → Create new API keys.
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Where Langfuse runs. Pick one:
LANGFUSE_BASE_URL=http://localhost:3040           # Langfuse on your computer (see README)
# LANGFUSE_BASE_URL=https://cloud.langfuse.com     # Langfuse Cloud, EU
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com  # Langfuse Cloud, US

# ---------------------------------------------------------------------------
# App settings (optional)
# ---------------------------------------------------------------------------
# HAUSHALTSBUCH_DB_PATH=data/haushaltsbuch.sqlite   # where the database file lives
# HAUSHALTSBUCH_CHAT_MODEL=gpt-5.6-luna             # OpenAI model for chat and PDF import
